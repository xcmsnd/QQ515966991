local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local CACHE = {}
local TRANSLATE_ENABLED = true

local function translateText(text, target)
    if not TRANSLATE_ENABLED then return text end
    
    target = target or "zh-CN"
    
    if CACHE[text] then 
        return CACHE[text] 
    end
    
    if not text or #text < 2 or #text > 100 then 
        return text 
    end
    
    if not text:match("[A-Za-z]") then
        return text
    end
    
    local encodedText = HttpService:UrlEncode(text)
    local url = "https://translate.googleapis.com/translate_a/single?client=gtx&dt=t&q="
        .. encodedText .. "&tl=" .. target .. "&sl=auto"
    
    local success, response = pcall(function()
        return game:HttpGetAsync(url)
    end)

    if not success or not response then
        return text
    end

    local success2, data = pcall(function()
        return HttpService:JSONDecode(response)
    end)

    if not success2 or not data or not data[1] or not data[1][1] or not data[1][1][1] then
        return text
    end

    local translated = data[1][1][1]
    CACHE[text] = translated
    return translated
end

local function createToggleButton()
    if not Players.LocalPlayer then return end
    
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "TranslationToggle"
    screenGui.ResetOnSpawn = false
    screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    
    local button = Instance.new("TextButton")
    button.Name = "ToggleButton"
    button.Size = UDim2.new(0, 50, 0, 50)
    button.Position = UDim2.new(0, 20, 0.5, -25)
    button.Active = true
    button.Draggable = true
    button.BackgroundColor3 = Color3.fromRGB(30, 136, 229)
    button.TextColor3 = Color3.new(1, 1, 1)
    button.Text = "译"
    button.TextSize = 20
    button.Font = Enum.Font.SourceSansBold
    button.BorderSizePixel = 0
    button.ZIndex = 1000
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = button
    
    local dragging = false
    local dragInput
    local dragStart
    local startPos
    
    button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            TRANSLATE_ENABLED = not TRANSLATE_ENABLED
            
            if TRANSLATE_ENABLED then
                button.BackgroundColor3 = Color3.fromRGB(30, 136, 229)
                button.Text = "译"
            else
                button.BackgroundColor3 = Color3.fromRGB(229, 57, 53)
                button.Text = "关"
            end
            
            local tween = TweenService:Create(button, TweenInfo.new(0.2), {
                Size = UDim2.new(0, 55, 0, 55)
            })
            tween:Play()
            tween.Completed:Wait()
            
            TweenService:Create(button, TweenInfo.new(0.2), {
                Size = UDim2.new(0, 50, 0, 50)
            }):Play()
        elseif input.UserInputType == Enum.UserInputType.Touch then
            TRANSLATE_ENABLED = not TRANSLATE_ENABLED
            
            if TRANSLATE_ENABLED then
                button.BackgroundColor3 = Color3.fromRGB(30, 136, 229)
                button.Text = "译"
            else
                button.BackgroundColor3 = Color3.fromRGB(229, 57, 53)
                button.Text = "关"
            end
        end
    end)
    
    button.Parent = screenGui
    screenGui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
    
    return button
end

local function setupTextHook()
    local oldMeta = getrawmetatable(game)
    if not oldMeta then return end
    
    local oldIndex = oldMeta.__newindex
    local oldNamecall
    if oldMeta.__namecall then
        oldNamecall = oldMeta.__namecall
    end
    
    setreadonly(oldMeta, false)
    
    oldMeta.__newindex = function(self, key, value)
        if key == "Text" and type(value) == "string" and value ~= "" then
            task.spawn(function()
                local translated = translateText(value)
                if translated ~= value then
                    value = translated
                end
            end)
        end
        return oldIndex(self, key, value)
    end
    
    if oldNamecall then
        oldMeta.__namecall = function(self, ...)
            local method = getnamecallmethod()
            local args = {...}
            
            if (method == "SetText" or method == "setText") and 
               type(args[1]) == "string" and args[1] ~= "" then
                task.spawn(function()
                    local translated = translateText(args[1])
                    if translated ~= args[1] then
                        args[1] = translated
                    end
                end)
            end
            
            return oldNamecall(self, unpack(args))
        end
    end
    
    setreadonly(oldMeta, true)
end

task.spawn(function()
    setupTextHook()
    createToggleButton()
    
    task.wait(1)
    
    pcall(function()
        loadstring(game:HttpGet("https://raw.githubusercontent.com/infyiff/backup/main/dex.lua"))()    
